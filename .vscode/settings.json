{
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  //  .editorconfig
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "files.encoding": "utf8",
  "editor.insertSpaces": true,
  "editor.tabSize": 2,
  "editor.detectIndentation": false,
  "files.trimTrailingWhitespace": true,
  "editor.rulers": [80]
}
